# Copy to .env at the repo root. Read by docker-compose (POSTGRES_*) and by apps/api (DATABASE_URL).
# .env is gitignored; never commit real credentials.

POSTGRES_USER=hunterseeker
POSTGRES_PASSWORD=hunterseeker
POSTGRES_DB=hunterseeker
POSTGRES_PORT=5432

# Async SQLAlchemy URL for apps/api. Must use the postgresql+asyncpg driver.
DATABASE_URL=postgresql+asyncpg://hunterseeker:hunterseeker@localhost:5432/hunterseeker

# Log every SQL statement (dev only).
ECHO_SQL=false

# Width of the pgvector columns on the embedding tables. Placeholder until issue #4 is decided.
EMBEDDING_DIM=1024
